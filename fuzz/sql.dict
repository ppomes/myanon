# AFL++ dictionary: tokens of MySQL dumps and of the JSON values inside them.
# Helps the mutator get past the grammar instead of guessing keywords byte by byte.
insert="INSERT INTO "
insert_ignore="INSERT IGNORE INTO "
values=" VALUES "
create="CREATE TABLE "
drop="DROP TABLE IF EXISTS "
lock="LOCK TABLES "
unlock="UNLOCK TABLES;"
write=" WRITE"
primary="PRIMARY KEY"
null="NULL"
engine=") ENGINE=InnoDB"
charset=" DEFAULT CHARSET=utf8mb4"
autoinc=" AUTO_INCREMENT"
notnull=" NOT NULL"
int_t=" int"
varchar_t=" varchar(255)"
json_t=" json"
text_t=" text"
blob_t=" blob"
datetime_t=" datetime"
cond_open="/*!40000 "
cond_close=" */;"
comment="-- "
backtick="`"
quote="'"
dquote="\""
esc_quote="\\'"
esc_dquote="\\\""
esc_bs="\\\\"
esc_n="\\n"
esc_0="\\0"
esc_Z="\\Z"
paren_open="("
paren_close=")"
tuple_sep="),("
semicolon=";"
comma=","
hex="0x"
# JSON
j_open="{"
j_close="}"
a_open="["
a_close="]"
colon=":"
j_true="true"
j_false="false"
j_null="null"
j_esc_u="\\u0041"
j_esc_q="\\\""
j_email="\"email\":"
j_name="\"name\":"
j_first="\"first_name\":"
j_last="\"last_name\":"
j_changes="\"email_changes\":"
j_meta="\"meta\":"
j_tags="\"tag-list\":"
j_at="@example.com"
# Anonymised tables and fields named in fuzz.conf
t_tata="`tata`"
t_toto="`toto`"
t_players="`players`"
t_points="`points`"
t_user="`user`"
t_documents="`documents`"
t_anontest="`anontest`"
t_prodplayers="`prodplayers`"
f_email="`email`"
f_name="`name`"
f_owner="`owner`"
f_metadata="`metadata`"
f_id="`id`"
